<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1000" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.DashboardController">

    <!-- Barre du haut -->
    <top>
        <ToolBar style="-fx-background-color:#009688;">
            <Button fx:id="logoutButton" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Déconnexion" />
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </ToolBar>
    </top>

    <!-- Partie centrale -->
    <center>
        <SplitPane dividerPositions="0.3">

            <!-- Sélection Client / Produit -->
            <VBox prefWidth="300" spacing="10">
                <Label text="Sélection Client" />
                <TextField fx:id="searchClientField" promptText="Rechercher client..." />
                <TableView fx:id="clientTable" prefHeight="200" />

                <Label text="Produits" />
                <TextField fx:id="searchProductField" promptText="Rechercher produit..." />
                <TableView fx:id="productTable" prefHeight="200" VBox.vgrow="ALWAYS" />
            <padding>
               <Insets left="5.0" right="5.0" />
            </padding>
            </VBox>

            <!-- Panier et Aperçu -->
            <VBox spacing="10">
                <Label text="Panier" />
                <TableView fx:id="cartTable" prefHeight="403.0" prefWidth="696.0" VBox.vgrow="ALWAYS" />
                <Label text="Aperçu de la facture" />
                <TextArea fx:id="invoicePreview" prefHeight="200.0" prefWidth="681.0" />
                <HBox spacing="10">
                    <Button fx:id="printButton" text="Imprimer / Enregistrer" />
                    <Button fx:id="cancelButton" text="Annuler" />
               <padding>
                  <Insets left="5.0" right="5.0" />
               </padding>
                </HBox>
            <padding>
               <Insets left="5.0" right="5.0" />
            </padding>
            </VBox>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </SplitPane>
    </center>
</BorderPane>
