<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.DashboardController">

    <!-- Partie centrale -->

    <center>
        <SplitPane dividerPositions="0.35">
            <!-- Colonne gauche : Clients + Produits -->
            <VBox prefWidth="380" spacing="12">
                <TitledPane expanded="true" text="Sélection Client">
                    <VBox spacing="8">
                        <TextField fx:id="searchClientField" promptText="Rechercher client..." />
                        <TableView fx:id="clientTable" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="colClientId" prefWidth="60" text="ID" />
                                <TableColumn fx:id="colClientNom" prefWidth="180" text="Nom" />
                                <TableColumn fx:id="colClientTel" prefWidth="120" text="Téléphone" />
                            </columns>
                        </TableView>
                        <HBox spacing="8">
                            <Button fx:id="btnAddClient" onAction="#onAddClient" text="Nouveau client" />
<!--                            <Button fx:id="btnEditClient"  text="Modifier" />-->
                        </HBox>
                        <padding><Insets bottom="5" left="5" right="5" top="5" /></padding>
                    </VBox>
                </TitledPane>

                <TitledPane expanded="true" text="Produits">
                    <VBox spacing="8">
                        <TextField fx:id="searchProductField" promptText="Rechercher produit..." />
                        <TableView fx:id="productTable" prefHeight="280" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProdId" prefWidth="60" text="ID" />
                                <TableColumn fx:id="colProdNom" prefWidth="180" text="Désignation" />
                                <TableColumn fx:id="colProdCategorie" prefWidth="120" text="Catégorie" />
                                <TableColumn fx:id="colProdPrix" prefWidth="90" text="Prix" />
                                <TableColumn fx:id="colProdStock" prefWidth="80" text="Stock" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Qté:" />
                            <Spinner fx:id="qtySpinner" editable="true" prefWidth="90" />
                            <Button fx:id="btnAddToCart" onAction="#onAddToCart" text="Ajouter au panier" />
                        </HBox>
                    </VBox>
                </TitledPane>
                <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
            </VBox>

            <!-- Colonne droite : Panier + Facture -->
            <VBox spacing="10">
                <TitledPane expanded="true" text="Panier">
                    <VBox spacing="8">
                        <TableView fx:id="cartTable" editable="true" prefHeight="320" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCartProd" prefWidth="220" text="Produit" />
                                <TableColumn fx:id="colCartQty" prefWidth="80" text="Qté" />
                                <TableColumn fx:id="colCartPrice" prefWidth="100" text="P.U." />
                                <TableColumn fx:id="colCartSubtotal" prefWidth="120" text="Sous-Total" />
                            </columns>
                        </TableView>
                        <HBox spacing="8">
                            <Button fx:id="btnRemoveLine" onAction="#onRemoveLine" text="Retirer" />
                            <Button fx:id="btnClearCart" onAction="#onClearCart" text="Vider" />
                            <Pane HBox.hgrow="ALWAYS" />
                            <Label text="Total:" />
                            <Label fx:id="totalLabel" style="-fx-font-weight:bold;" />
                        </HBox>
                        <padding><Insets bottom="5" left="5" right="5" top="5" /></padding>
                    </VBox>
                </TitledPane>

                <TitledPane expanded="true" text="Aperçu - Paiement">
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Mode de paiement:" />
                            <ComboBox fx:id="paymentCombo" prefWidth="180" />
                            <Label text="Caissier:" />
                            <Label fx:id="currentUserLabel" style="-fx-font-weight:bold;" />
                        </HBox>
                        <TextArea fx:id="invoicePreview" prefHeight="160" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="printButton" onAction="#onPrintAndSave" text="Imprimer / Enregistrer" />
                            <Button fx:id="cancelButton" text="Annuler" />
                        </HBox>
                        <padding><Insets bottom="5" left="5" right="5" top="5" /></padding>
                    </VBox>
                </TitledPane>
                <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
            </VBox>
        </SplitPane>
    </center>
   <top>
        <ToolBar fx:id="toolBar" nodeOrientation="LEFT_TO_RIGHT" style="-fx-background-color:#009688;" BorderPane.alignment="CENTER">
            <Button fx:id="produitsButton" onAction="#handleProduits" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Produits" />
            <Button fx:id="facturesButton" onAction="#handleFactures" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Factures" />
            <Button fx:id="fournisseursButton" onAction="#handleFournisseurs" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Fournisseurs" />
            <Button fx:id="clientsButton" onAction="#handleClients" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Clients" />
            <Button fx:id="employesButton" onAction="#handleEmployes" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Utilisateurs" />

            <Button fx:id="recettesButton" onAction="#handleRecettes" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Rapports" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Actualiser" />
            <Button fx:id="logoutButton" alignment="CENTER" onAction="#handleDeconnexion" style="-fx-background-color:#ff5252; -fx-text-fill:white;" text="Déconnexion" />
        </ToolBar>
   </top>
</BorderPane>
