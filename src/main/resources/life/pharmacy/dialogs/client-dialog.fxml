<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="296.0" prefWidth="360.0" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="life.pharmacy.controllers.dialogcontrollers.ClientDialogController">
    <Label text="Nom complet" />
    <TextField fx:id="txtNomComplet" />
    <Label text="Téléphone" />
    <TextField fx:id="txtTelephone" />
    <Label text="Email" />
    <TextField fx:id="txtEmail" />
    <Label text="Adresse" />
    <TextField fx:id="txtAdresse" />
    <HBox spacing="10">
        <Button onAction="#handleSave" text="Enregistrer" />
        <Button onAction="#handleCancel" text="Annuler" />
    </HBox>
    <padding>
        <Insets bottom="7" left="7" right="7" top="7" />
    </padding>
</VBox>
