<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="life.pharmacy.controllers.dialogcontrollers.ClientDialogController"
      spacing="10">
    <Label text="Nom complet"/>
    <TextField fx:id="txtNomComplet"/>
    <Label text="Téléphone"/>
    <TextField fx:id="txtTelephone"/>
    <Label text="Email"/>
    <TextField fx:id="txtEmail"/>
    <Label text="Adresse"/>
    <TextField fx:id="txtAdresse"/>
    <HBox spacing="10">
        <Button text="Enregistrer" onAction="#handleSave"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>
    <padding>
        <Insets top="7" right="7" bottom="7" left="7"/>
    </padding>
</VBox>
