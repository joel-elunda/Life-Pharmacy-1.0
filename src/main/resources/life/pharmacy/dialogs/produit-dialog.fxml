<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="life.pharmacy.controllers.dialogcontrollers.ProduitDialogController"
      spacing="10">
    <Label text="Nom commercial"/>
    <TextField fx:id="txtNom"/>

    <Label text="Nom générique"/>
    <TextField fx:id="txtGenerique"/>

    <Label text="Code-barres"/>
    <TextField fx:id="txtCodeBarres"/>

    <Label text="Prix d'achat"/>
    <TextField fx:id="txtPrixAchat"/>

    <Label text="Prix de vente"/>
    <TextField fx:id="txtPrixVente"/>

    <Label text="Stock"/>
    <TextField fx:id="txtStock"/>

    <HBox spacing="10">
        <Button text="Enregistrer" onAction="#handleSave"/>
        <Button text="Annuler" onAction="#handleCancel"/>
    </HBox>
    <padding>
        <Insets top="7" right="7" bottom="7" left="7"/>
    </padding>
</VBox>
