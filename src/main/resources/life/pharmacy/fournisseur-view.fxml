<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.FournisseurController">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10">
         <Label prefHeight="23.0" prefWidth="283.0" text="Gestion des fournisseurs ">
            <font>
               <Font name="Calibri Light" size="20.0" />
            </font>
         </Label>
            <ComboBox fx:id="comboResearch" editable="true" prefHeight="25.0" prefWidth="217.0" promptText="Rechercher un fournisseur..." />
            <Button mnemonicParsing="false" onAction="#onSearch" prefHeight="25.0" prefWidth="90.0" text="Rechercher" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Actualiser" />
            <Button fx:id="importButton" onAction="#handleImportExcel" text="Importer Excel" />
            <Button fx:id="exportButton" onAction="#handleExportExcel" text="Exporter Excel" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colNom" text="Nom" />
            <TableColumn fx:id="colEmail" prefWidth="75.0" text="Email" />
                <TableColumn fx:id="colContact" text="Contact" />
            <TableColumn fx:id="colTelephone" prefWidth="75.0" text="Téléphone" />
                <TableColumn fx:id="colAdresse" text="Adresse" />
            <TableColumn fx:id="colConditionsPaiement" prefWidth="75.0" text="Conditions de paiement" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="deleteButton" onAction="#onDelete" style="-fx-background-color: #F00;" text="Supprimer" textFill="WHITE" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </bottom>
   <right>
      <VBox prefHeight="529.0" prefWidth="289.0" spacing="5.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </padding>
         <children>
            <Label text="Fournisseur" />
            <Separator prefWidth="200.0" />
            <Label text="Nom :" />
            <TextField fx:id="fieldNom" promptText="John Doe" />
            <Label text="Email :" />
            <TextField fx:id="fieldEmail" promptText="exemple@email.com" />
            <Label text="Contact :" />
            <TextField fx:id="fieldContact" />
            <Label text="Numéro de téléphone :" />
            <TextField fx:id="fieldTelephone" promptText="+243 11 22 33 444" />
            <Label text="Adresse : " />
            <TextField fx:id="fieldAdresse" promptText="01, Avenue Av, Lubumbashi, Haut-Katanga, RDC" />
            <Label text="Condition de paiement :" />
            <TextArea fx:id="areaConditionsPaiement" prefHeight="144.0" prefWidth="275.0" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                     <Button fx:id="addButton" onAction="#onAdd" prefHeight="25.0" prefWidth="90.0" style="-fx-background-color: #24b21a;" text="Ajouter" textFill="WHITE" />
                     <Button fx:id="editButton" onAction="#onEdit" prefHeight="25.0" prefWidth="90.0" text="Modifier" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>
