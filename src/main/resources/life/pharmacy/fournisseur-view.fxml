<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.FournisseurController">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <TextField fx:id="searchField" prefHeight="26.0" prefWidth="230.0" promptText="Rechercher fournisseur..." />
            <Button fx:id="importButton" text="Importer Excel" />
            <Button fx:id="exportButton" text="Exporter Excel" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="fournisseurTable">
            <columns>
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colNom" text="Nom" />
                <TableColumn fx:id="colContact" text="Contact" />
                <TableColumn fx:id="colAdresse" text="Adresse" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="addButton" text="Ajouter" />
            <Button fx:id="editButton" text="Modifier" />
            <Button fx:id="deleteButton" text="Supprimer" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </bottom>
</BorderPane>
