<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane prefWidth="400" prefHeight="300" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="life.pharmacy.controllers.LoginController">
    <children>
        <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.bottomAnchor="30">
            <Label text="Connexion" style="-fx-font-size:18px; -fx-text-fill:#009688;"/>
            <TextField fx:id="usernameField" promptText="Nom d'utilisateur"/>
            <PasswordField fx:id="passwordField" promptText="Mot de passe"/>
            <Button text="Se connecter" fx:id="loginButton" />
        </VBox>
    </children>
</AnchorPane>
