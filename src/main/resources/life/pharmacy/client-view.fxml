<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.ClientController">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <TextField fx:id="fieldRechercher" prefHeight="26.0" prefWidth="230.0" promptText="Rechercher client..." />
         <Button fx:id="searchButton" mnemonicParsing="false" onAction="#onSearch" prefHeight="25.0" prefWidth="95.0" text="Rechercher" />
            <Button fx:id="importButton" onAction="#onImportExcel" text="Importer Excel" />
            <Button fx:id="exportButton" onAction="#onExportExcel" text="Exporter Excel" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" prefWidth="33.0" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="127.0" text="Nom" />
            <TableColumn fx:id="colEmail" prefWidth="75.0" text="Email" />
                <TableColumn fx:id="colTelephone" text="Téléphone" />
                <TableColumn fx:id="colAdresse" text="Adresse" />
            <TableColumn fx:id="colDateNaissance" prefWidth="75.0" text="Date de naissance" />
            <TableColumn fx:id="colConditionsMedicales" prefWidth="75.0" text="Conditions médicales" />
            <TableColumn fx:id="colAllergies" prefWidth="75.0" text="Allergies" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="deleteButton" onAction="#onDelete" text="Supprimer" />
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
        </HBox>
    </bottom>
   <right>
      <VBox prefHeight="529.0" prefWidth="289.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </padding>
         <children>
            <Label text="Client" />
            <TextField fx:id="fieldNom" promptText="Nom" />
            <TextField fx:id="fieldEmail" promptText="Email" />
            <TextField fx:id="fieldTelephone" promptText="Télephone" />
            <TextField fx:id="fieldAdresse" promptText="Adresse" />
            <DatePicker fx:id="dateDateNaissance" promptText="Date de naissaince" />
            <TextArea fx:id="areaConditionsMedicales" prefHeight="72.0" prefWidth="275.0" />
            <TextArea fx:id="areaAllergies" prefHeight="72.0" prefWidth="275.0" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                     <Button fx:id="addButton" onAction="#onAdd" prefHeight="25.0" prefWidth="90.0" text="Ajouter" />
                     <Button fx:id="editButton" onAction="#onEdit" prefHeight="25.0" prefWidth="90.0" text="Modifier" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>
