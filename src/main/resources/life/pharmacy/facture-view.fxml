<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620" prefWidth="980" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.FactureController">

    <top>
        <ToolBar style="-fx-background-color:#009688;">
            <Label style="-fx-text-fill:white; -fx-font-size:16px;" text="Factures" />
            <Pane HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchFactureField" prefHeight="26.0" prefWidth="200.0" promptText="Rechercher… (ID/Client)" />
            <Button fx:id="searchButton" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Rechercher" />
            <Button fx:id="refreshButton" style="-fx-background-color:#ffffff; -fx-text-fill:#009688;" text="Rafraîchir" />
        </ToolBar>
    </top>

    <center>
        <VBox spacing="10">
            <TableView fx:id="factureTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="90" text="ID" />
                    <TableColumn fx:id="colClient" prefWidth="220" text="Client" />
                    <TableColumn fx:id="colEmploye" prefWidth="200" text="Employé" />
                    <TableColumn fx:id="colDate" prefWidth="150" text="Date" />
                    <TableColumn fx:id="colMontant" prefWidth="120" text="Montant" />
                    <TableColumn fx:id="colModePaiement" prefWidth="140" text="Paiement" />
                </columns>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="newButton" text="Nouvelle" />
                <Button fx:id="editButton" text="Modifier" />
                <Button fx:id="deleteButton" text="Supprimer" />
                <Button fx:id="exportButton" text="Exporter" />
            </HBox>
            <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
        </VBox>
    </center>
</BorderPane>
