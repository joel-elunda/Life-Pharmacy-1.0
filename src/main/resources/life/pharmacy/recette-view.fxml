<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.RecetteController">

    <top>
        <ToolBar style="-fx-background-color:#009688;">
            <Label style="-fx-text-fill:white; -fx-font-size:16px;" text="Statistiques des recettes" />
            <ComboBox fx:id="comboPeriode" prefWidth="200" promptText="Sélectionner période" />
            <Button fx:id="btnActualiser" onAction="#handleRefresh" text="Actualiser" />
            <Button fx:id="btnImprimer" onAction="#handlePrint" text="Imprimer" />
            <Button fx:id="btnExporter" onAction="#onExportRecettes" text="Exporter Excel" />
         <Button fx:id="btnResetYear" mnemonicParsing="false" text="Réinitialiser l'année" />
        </ToolBar>
    </top>

    <center>
        <LineChart fx:id="chartRecettes" prefHeight="500" prefWidth="800">
            <xAxis>
                <CategoryAxis fx:id="xAxis" label="Période" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Montant" />
            </yAxis>
        </LineChart>
    </center>
</BorderPane>
