<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.RecetteController">

    <top>
        <ToolBar style="-fx-background-color:#009688;">
            <Label style="-fx-text-fill:white; -fx-font-size:16px;" text="Statistiques des recettes" />
            <ComboBox fx:id="filtrePeriode" prefWidth="200" promptText="Sélectionner période" />
            <Button fx:id="refreshButton" text="Actualiser" />
            <Button fx:id="printButton" text="Imprimer" />
            <Button fx:id="exportButton" text="Exporter Excel" />
        </ToolBar>
    </top>

    <center>
        <LineChart fx:id="recetteChart" prefHeight="500" prefWidth="800">
            <xAxis>
                <CategoryAxis label="Période" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Montant" />
            </yAxis>
        </LineChart>
    </center>
</BorderPane>
