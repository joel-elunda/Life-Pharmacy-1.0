<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.EmployeController">

    <top>
        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="Rechercher un employé..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRechercher" text="Rechercher" />
            <Button fx:id="addButton" onAction="#onAdd" text="Ajouter" />
            <Button fx:id="editButton" onAction="#onEdit" text="Modifier" />
            <Button fx:id="deleteButton" onAction="#onDelete" text="Supprimer" />
            <Button onAction="#handleExportExcel" text="Exporter Excel" />
            <Button onAction="#handleImportExcel" text="Importer Excel" />
            <padding>
                <Insets bottom="7" left="7" right="7" top="7" />
            </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="200" text="Nom" />
                <TableColumn fx:id="colRole" prefWidth="150" text="Rôle" />
                <TableColumn fx:id="colLogin" prefWidth="150" text="Login" />
            </columns>
        </TableView>
    </center>

</BorderPane>
