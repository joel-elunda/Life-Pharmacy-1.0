<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="life.pharmacy.controllers.EmployeController">

    <top>
        <HBox alignment="TOP_RIGHT" spacing="10">
         <Label alignment="CENTER" prefHeight="23.0" prefWidth="291.0" text="Gestion d'utilisateurs">
            <font>
               <Font name="Calibri Light" size="20.0" />
            </font>
         </Label>
            <ComboBox fx:id="comboResearch" editable="true" prefHeight="25.0" prefWidth="217.0" promptText="Rechercher un utilisateur..." />
            <Button fx:id="searchButton" onAction="#onSearch" text="Rechercher" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Actualiser" />
            <Button onAction="#onExportExcel" text="Exporter Excel" />
            <Button onAction="#onImportExcel" text="Importer Excel" />
            <padding>
                <Insets bottom="7" left="7" right="7" top="7" />
            </padding>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableView" prefHeight="473.0" prefWidth="495.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="42.0" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="94.0" text="Nom" />
                <TableColumn fx:id="colRole" prefWidth="89.0" text="Rôle" />
                <TableColumn fx:id="colLogin" prefWidth="111.0" text="Login" />
            </columns>
        </TableView>
    </center>
   <right>
      <VBox prefHeight="515.0" prefWidth="282.0" spacing="5.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="7.0" left="7.0" right="7.0" top="7.0" />
         </padding>
         <children>
            <Label text="Utilisateur" />
            <Separator prefWidth="200.0" />
            <Label text="Nom :" />
            <TextField fx:id="fiedlNomComplet" promptText="John Doe" />
            <Label text="Rôle :" />
            <ComboBox fx:id="comboRole" prefHeight="25.0" prefWidth="330.0" VBox.vgrow="ALWAYS" />
            <Label text="Login : " />
            <TextField fx:id="fieldLogin" promptText="john_doe" />
            <Label text="Mot de passe :" />
            <PasswordField fx:id="fieldMotDePasseHash" promptText="**** ****" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                     <Button fx:id="addButton" onAction="#onAdd" prefHeight="25.0" prefWidth="90.0" style="-fx-background-color: #24b21a;" text="Ajouter" textFill="WHITE" />
                     <Button fx:id="editButton" onAction="#onEdit" prefHeight="25.0" prefWidth="90.0" text="Modifier" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
   <bottom>
         <Button fx:id="deleteButton" onAction="#onDelete" style="-fx-background-color: #F00;" text="Supprimer" textFill="WHITE" BorderPane.alignment="TOP_LEFT">
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </Button>
   </bottom>

</BorderPane>
